# vault-mcp local development — copy to .env.dev (optional: the defaults in
# docker-compose.dev.yml work without it).

# --- Search ---

# typesense: remember/recall/digest over Typesense, search_notes removed.
# Unset: plain vellum with its in-memory search and no vault tools.
VAULT_SEARCH=typesense
# The compose's own Typesense. For `go run` outside Docker use
# http://localhost:8108 (docs/dev.md).
TYPESENSE_URL=http://typesense:8108
# Fixed development key; the compose passes the same value to Typesense.
TYPESENSE_API_KEY=vault-dev-key
TYPESENSE_COLLECTION=vault_sections
# A built-in Typesense model (huggingface.co/typesense/models). Changing it
# needs `reindex --wipe`: the collection keeps the model it was created with.
TYPESENSE_EMBED_MODEL=ts/multilingual-e5-small

# --- Ports on localhost ---

VAULT_MCP_PORT=8080
TYPESENSE_PORT=8108

# --- Vault ---

# The server runs as this user so ./vault stays editable by you (id -u, id -g).
VAULT_UID=1000
VAULT_GID=1000

# Notes live in one inbox folder; don't create projects/ and archive/.
VELLUM_INIT_STRUCTURE=false
VELLUM_INBOX_DIR=inbox

# --- Auth ---

# Off for local use: /mcp is reachable from this machine only.
AUTH_ENABLED=false
