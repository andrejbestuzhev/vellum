# vault-mcp on the shared infra — copy to .env next to
# docker-compose.vault.yml and fill in. Never commit the filled-in file.

# Lets plain `docker compose ...` in this folder use the vault compose file
# (the nightly reindex cron relies on it).
COMPOSE_FILE=docker-compose.vault.yml

# --- Public address ---

# Host Traefik routes to this server (DNS must point at the server).
VAULT_MCP_HOST=vault.example.com
# The same as an HTTPS URL. Without it the OAuth metadata names localhost
# and clients fail.
VELLUM_ISSUER_URL=https://vault.example.com
# Version reported by /healthz; scripts/vault-deploy.sh sets the commit.
VAULT_MCP_VERSION=dev

# --- OAuth (one client secret is the access key) ---

VELLUM_CLIENT_ID=vault-mcp
# openssl rand -hex 32
VELLUM_CLIENT_SECRET=
# Optional exact redirect URI allowlist (empty = allow any).
# Claude callback: https://claude.ai/api/mcp/auth_callback
VELLUM_REDIRECT_URIS=
# Browser origins allowed to call /mcp.
VELLUM_ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# --- Search (VAULT_SEARCH=typesense is set by the compose) ---

# The shared Typesense on the `db` network.
TYPESENSE_URL=http://typesense:8108
# A key scoped to the collection below (docs/deploy.md shows how to make
# one); the instance's admin key works too but reaches every collection.
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=vault_sections
TYPESENSE_EMBED_MODEL=ts/multilingual-e5-small

# --- Vault ---

VELLUM_INBOX_DIR=inbox
# Changes made outside the server are picked up by the vault watcher in
# Typesense mode; this only drives vellum's own lazy rescan.
VELLUM_RESCAN=5s

# --- Optional: Sentry ---

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
